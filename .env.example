# ===========================================
# WBS v2 - Environment Configuration
# ===========================================

# Application
APP_NAME="WBS Kota Bontang"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# APP_URL = skema://domain publik. Apache (host) mem-proxy ke container ini.
# Server testing TLS-off -> pakai http. Bila nanti pasang HTTPS di Apache,
# ubah ke https:// (TrustProxies sudah membaca header X-Forwarded-Proto).
APP_URL=http://devapps-wbs.bontangkota.go.id
# APP_PORT = port loopback container di host (127.0.0.1:APP_PORT) yang dituju
# VirtualHost Apache. WAJIB UNIK antar aplikasi (mis. sipadu=8001, wbs=8003).
APP_PORT=8003

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Makassar

BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error

# Database (Docker)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=wbs_v2
DB_USERNAME=wbs_user
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Session Configuration
SESSION_DRIVER=database
SESSION_LIFETIME=480  # Session lifetime in minutes (480 = 8 hours)
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=  # Leave empty for single domain, or set to .yourdomain.com for subdomains

# Security Settings (IMPORTANT for Production)
SESSION_SECURE_COOKIE=false  # MUST be true in production with HTTPS
SESSION_HTTP_ONLY=true       # Prevent JavaScript access to session cookie
SESSION_SAME_SITE=lax        # CSRF protection (lax|strict|none)

# Queue & Cache
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# Redis (optional)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Mail (configure for production)
MAIL_MAILER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="wbs@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Google reCAPTCHA v2
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
